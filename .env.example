# Copy this file to .env.local and enter values for the new college's project.
# Use only publishable/anon keys in EXPO_PUBLIC_* variables. Never place a service-role
# or Supabase secret key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_APP_ORIGIN=https://your-app-domain.example
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key_if_needed

EXPO_PUBLIC_ENABLE_ONBOARDING=false
EXPO_PUBLIC_ENABLE_COMMUNICATION_CENTER=false
EXPO_PUBLIC_CUSTOM_RENDERER_ENABLED=false
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_R2_BUCKET=
EXPO_PUBLIC_R2_PUB_DOMAIN=
# Match the source provider. Add target R2 server secrets before testing uploads.
EXPO_PUBLIC_STORAGE_PROVIDER=r2
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=
