@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 240 11% 4%;
    --card: 0 0% 100%;
    --card-foreground: 240 11% 4%;
    --popover: 0 0% 100%;
    --popover-foreground: 240 11% 4%;
    --primary: 240 6% 10%;
    --primary-foreground: 180 0% 98%;
    --secondary: 240 4% 96%;
    --secondary-foreground: 240 6% 10%;
    --muted: 240 4% 96%;
    --muted-foreground: 240 4% 46%;
    --accent: 240 4% 96%;
    --accent-foreground: 240 6% 10%;
    --destructive: 357 100% 45%;
    --destructive-foreground: 210 40% 98%;
    --border: 240 6% 90%;
    --input: 240 6% 90%;
    --ring: 240 6% 64%;
    --radius: 0.45rem;
    --chart-1: 187 98% 66%;
    --chart-2: 189 100% 43%;
    --chart-3: 192 100% 36%;
    --chart-4: 193 100% 29%;
    --chart-5: 193 100% 24%;
    --sidebar-background: 187 77% 11%;
    --sidebar-foreground: 240 11% 4%;
    --sidebar-primary: 240 6% 10%;
    --sidebar-primary-foreground: 180 0% 98%;
    --sidebar-accent: 240 4% 96%;
    --sidebar-accent-foreground: 240 6% 10%;
    --sidebar-border: 240 6% 90%;
    --sidebar-ring: 240 6% 64%;
    --sidebar: 180 0% 98%;
  }

  .dark {
    --background: 240 11% 4%;
    --foreground: 180 0% 98%;
    --card: 240 6% 10%;
    --card-foreground: 180 0% 98%;
    --popover: 240 6% 10%;
    --popover-foreground: 180 0% 98%;
    --primary: 240 6% 90%;
    --primary-foreground: 240 6% 10%;
    --secondary: 240 4% 16%;
    --secondary-foreground: 180 0% 98%;
    --muted: 240 4% 16%;
    --muted-foreground: 240 6% 64%;
    --accent: 240 4% 16%;
    --accent-foreground: 180 0% 98%;
    --destructive: 359 100% 70%;
    --destructive-foreground: 210 40% 98%;
    --border: 0 0% 100% / 10%;
    --input: 0 0% 100% / 15%;
    --ring: 240 4% 46%;
    --chart-1: 187 98% 66%;
    --chart-2: 189 100% 43%;
    --chart-3: 192 100% 36%;
    --chart-4: 193 100% 29%;
    --chart-5: 193 100% 24%;
    --sidebar-background: 187 77% 8%;
    --sidebar-foreground: 180 0% 98%;
    --sidebar-primary: 225 84% 49%;
    --sidebar-primary-foreground: 180 0% 98%;
    --sidebar-accent: 240 4% 16%;
    --sidebar-accent-foreground: 180 0% 98%;
    --sidebar-border: 0 0% 100% / 10%;
    --sidebar-ring: 240 4% 46%;
    --sidebar: 240 6% 10%;
  }
  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'Inter Variable', sans-serif;
  }
  * {
    /* @apply border-border outline-ring/50; */
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

*, ::before, ::after {
  box-sizing: border-box;
  border-width: 0;
  border-style: solid;
}

html, body, #root, #__next {
  height: 100%;
  min-height: 0;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Custom Scrollbars for Web */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(100, 116, 139, 0.32);
  border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(15, 118, 110, 0.62);
}

/* Hide scrollbar utility for both Webkit (Safari, Chrome) and standards (Firefox, IE) */
.no-scrollbar::-webkit-scrollbar {
  display: none !important;
}
.no-scrollbar {
  -ms-overflow-style: none !important;  /* IE and Edge */
  scrollbar-width: none !important;  /* Firefox */
}
/* Refined Dashboard Soft-Glass Theme */
.welcome-card, .metric-card, .action-card {
  background: rgba(255, 255, 255, 0.90) !important;
  backdrop-filter: blur(6px) !important;
  -webkit-backdrop-filter: blur(6px) !important;
  border: 1px solid rgba(100, 116, 139, 0.25) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.015) !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
}

.panel-card {
  background: rgba(255, 255, 255, 0.97) !important;
  border: 1px solid rgba(100, 116, 139, 0.25) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.015) !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
}

/* Only interactive quick-action cards get hover effects */
.action-card:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 3px 8px rgba(15, 23, 42, 0.025) !important;
  border-color: rgba(71, 85, 105, 0.34) !important;
}

/* Remove hover shadow for non-interactive statistic or data panels */
.metric-card:hover, .welcome-card:hover, .panel-card:hover {
  transform: none !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.015) !important;
}
