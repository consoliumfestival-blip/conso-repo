# Server-only template; do not prefix these keys with EXPO_PUBLIC_.
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# Keep this aligned with the target Vault-backed notification cron credential.
# It is already configured in the existing target; do not replace it casually.
CRON_AUTH_KEY=
